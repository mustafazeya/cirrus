# Azure Cloud Portal - Environment Configuration Template
# Copy this file to .env and configure for your environment

# Azure AD Configuration (User Authentication)
AZURE_TENANT_ID=5581c9a8-168b-45f0-abd4-d375da99bf9f

# Service Principal Configuration (AI & Background Services)
# Create a new App Registration for this with appropriate permissions
AZURE_SERVICE_PRINCIPAL_CLIENT_ID=""     # Application ID of the service principal
AZURE_SERVICE_PRINCIPAL_CLIENT_SECRET="" # Client secret (store securely!)
AZURE_SERVICE_PRINCIPAL_TENANT_ID=""     # Usually same as AZURE_TENANT_ID

# Azure Resources Configuration (from Terraform outputs)
RESOURCE_GROUP_NAME=""  # terraform output resource_group_name
KEY_VAULT_NAME=""       # terraform output key_vault_name  
KEY_VAULT_URI=""        # terraform output key_vault_uri

# Azure OpenAI Configuration (from Terraform deployment)
OPENAI_API_BASE=""      # terraform output openai_endpoint
OPENAI_API_KEY=""       # From Key Vault or terraform output
OPENAI_API_VERSION=2024-02-01
OPENAI_DEPLOYMENT_NAME=GPT-5

# Alternative: Standard OpenAI (if not using Azure OpenAI)
# OPENAI_API_KEY=""     # Standard OpenAI API key
# Leave OPENAI_API_BASE empty to use standard OpenAI

# Application Configuration
API_VERSION=v1
DEBUG=true  # Set to false in production
CORS_ORIGINS=["http://localhost:3000", "https://localhost:3000"]

# Admin Access Configuration
# Comma-separated list of email addresses that have admin access
ADMIN_EMAILS=mohammad.mustafa@sas.se,admin2@example.com

# Application Insights (optional for local dev)
APPINSIGHTS_CONNECTION_STRING=""

# Redis Cache Configuration
# Option 1: Use Azure Cache for Redis (recommended)
REDIS_URL=""  # terraform output redis_connection_string
# Option 2: Use local Redis for development  
# REDIS_URL=redis://localhost:6379
# Option 3: No Redis (uses in-memory cache)
# REDIS_URL=

CACHE_TTL=300  # Cache timeout in seconds (5 minutes)

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Setup Instructions:
# 1. Deploy infrastructure: terraform apply
# 2. Get values: terraform output
# 3. Fill in the empty variables above  
# 4. Save as .env (git ignored)
# 5. Start backend: uvicorn main:app --reload --port 8000