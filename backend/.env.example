# CloudEx — Backend Environment Configuration
# Copy this file to .env.local before running the app:
#   cp backend/.env.example backend/.env.local

# ── Azure AD (User Authentication) ───────────────────────────────────────────
# The tenant your users sign in from. Use "common" for multi-tenant.
AZURE_TENANT_ID=""

# ── Service Principal (AI & background services) ─────────────────────────────
# Create an App Registration in Azure Portal → App Registrations → New Registration
# Grant it Reader role on each subscription you want to query.
AZURE_SERVICE_PRINCIPAL_CLIENT_ID=""      # Application (client) ID
AZURE_SERVICE_PRINCIPAL_CLIENT_SECRET=""  # Client secret
AZURE_SERVICE_PRINCIPAL_TENANT_ID=""      # Same as AZURE_TENANT_ID in most cases

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Azure OpenAI resource endpoint — found in Azure Portal → Azure OpenAI → Keys and Endpoint
OPENAI_API_BASE=""                        # e.g. https://my-openai.openai.azure.com
OPENAI_API_KEY=""                         # API key from Azure Portal
OPENAI_API_VERSION="2024-12-01-preview"  # Keep this unless you upgrade the SDK
OPENAI_DEPLOYMENT_NAME=""                 # Your model deployment name, e.g. gpt-5.4

# ── Azure AI Search (documentation index) ────────────────────────────────────
# Used to inject live Microsoft Learn docs into KQL generation prompts.
# Optional — the app works without it but query quality improves with it.
AZURE_SEARCH_ENDPOINT=""                  # e.g. https://my-search.search.windows.net
AZURE_SEARCH_KEY=""                       # Admin or query key
AZURE_SEARCH_INDEX_NAME="microsoft-docs"  # Index name (default is fine for local)
USE_AZURE_SEARCH=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Application Insights (optional for local dev) ────────────────────────────
APPINSIGHTS_CONNECTION_STRING=""

# ── Redis (optional — in-memory cache used if empty) ─────────────────────────
# Leave empty to run without Redis (fine for local dev).
# Set to redis://localhost:6379 if you have a local Redis instance.
REDIS_URL=""
CACHE_TTL=300
